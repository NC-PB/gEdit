{
  "id": "heidenhain-klartext",
  "name": "Heidenhain Klartext",
  "shortName": "Heidenhain",
  "version": 1,
  "machineType": "mill",
  "grammar": "klartext",
  "codes": "heidenhain",
  "files": {
    "extensions": ["h"],
    "defaultExtension": "h",
    "filterName": "Heidenhain Klartext",
    "encoding": "keep",
    "lineEnding": "keep",
    "newFileLineEnding": "crlf"
  },
  "detect": {
    "extensions": { "h": 10 },
    "content": [
      { "pattern": "^\\s*\\d+\\s+BEGIN\\s+PGM\\s+\\S+\\s+(?:MM|INCH)(?![A-Z0-9_])", "weight": 5000 },
      { "pattern": "^\\s*(\\d+\\s+)?BEGIN\\s+PGM\\b", "weight": 5 },
      { "pattern": "^\\s*(\\d+\\s+)?TOOL\\s+CALL\\b", "weight": 5 },
      { "pattern": "^\\s*\\d+\\s+(?:(?:L|LN|LP|CC|C|CR|CT|CP|RND|CHF|APPR|DEP|LBL|CYCL|FN|PLANE|FUNCTION|TOOL|BLK|END)(?![A-Z0-9_])|[*;]|[MQ]\\d)", "weight": 2 },
      { "pattern": "\\bFMAX\\b", "weight": 1 }
    ]
  },
  "syntax": {
    "comments": [{ "start": ";", "end": null }],
    "strings": true,
    "sectionHeading": "^\\s*(?:/\\s*)?\\d+\\s+(?:/\\s*)?\\*",
    "continuation": "~\\s*$",
    "continuationMark": "~",
    "symbolAddresses": ["#"],
    "blockSkip": { "chars": "/", "position": "either" },
    "blockNumber": { "mode": "leading-integer", "mandatory": true },
    "decimalSeparator": ".",
    "decimalSeparatorAlt": ",",
    "decimalPointSignificant": false,
    "wordSeparatorRequired": true,
    "incrementalPrefix": "I",
    "variables": "Q[LRS]?\\d+",
    "keywords": [
      "BEGIN PGM",
      "END PGM",
      "BLK FORM",
      "TOOL CALL",
      "TOOL DEF",
      "CYCL DEF",
      "CYCL CALL PAT",
      "CYCL CALL POS",
      "CYCL CALL",
      "CALL LBL",
      "CALL PGM",
      "SEL PGM",
      "LBL",
      "REP",
      "APPR LT",
      "APPR LN",
      "APPR CT",
      "APPR LCT",
      "DEP LT",
      "DEP LN",
      "DEP CT",
      "DEP LCT",
      "RND",
      "CHF",
      "CTP",
      "CT",
      "CP",
      "CC",
      "CR",
      "LP",
      "LN",
      "L",
      "C",
      "FMAX",
      "FAUTO",
      "FN",
      "STOP",
      "PLANE SPATIAL",
      "PLANE RESET",
      "PLANE PROJECTED",
      "PLANE EULER",
      "PLANE VECTOR",
      "PLANE POINTS",
      "PLANE RELATIV",
      "PLANE AXIAL",
      "MOVE",
      "TURN",
      "STAY",
      "TABLE ROT",
      "COORD ROT",
      "SEQ+",
      "SEQ-",
      "MB",
      "MAX",
      "FUNCTION TCPM",
      "FUNCTION RESET TCPM",
      "F TCP",
      "F CONT",
      "AXIS POS",
      "AXIS SPAT",
      "PATHCTRL AXIS",
      "PATHCTRL VECTOR",
      "REFPNT TIP-TIP",
      "REFPNT TIP-CENTER",
      "REFPNT CENTER-CENTER",
      "TRANS DATUM",
      "MM",
      "INCH"
    ],
    "freeText": [
      "CYCL\\s+DEF\\s+\\d+(?:\\.0+)?\\s+(?<text>(?![A-Z]{1,2}[+\\-]?\\d)[^\\s;~+\\-.\\d#\"(](?:[^;~]*?[^\\s;~])?)(?=\\s*(?:[;~]|$)|\\s+Q\\d+\\s*=)",
      "CYCL\\s+DEF\\s+9\\.1\\s+(?<text>[A-Z][A-Z.\\-]*)(?=\\s*[+-]?\\d)",
      "(?:BEGIN|END)\\s+PGM\\s+(?<text>[^\\s;](?:[^;]*?[^\\s;])?)(?=\\s+(?:MM|INCH)\\s*(?:;|$))",
      "FN\\s*16\\s*:\\s*(?<text>[^\\s;](?:[^;]*?[^\\s;])?)(?=\\s*(?:;|$))",
      "CALL\\s+PGM\\s+(?<text>[^\\s;~\"]+)"
    ],
    "colonWords": ["VCONST", "VC", "HSC-MODE"],
    "tapeMarker": false
  },
  "addresses": {
    "feed": "F",
    "rapid": "FMAX",
    "spindle": "S",
    "axes": ["X", "Y", "Z", "A", "B", "C", "U", "V", "W"],
    "angular": ["A", "B", "C"],
    "feedUnitWords": { "FU": "per-rev", "FZ": "per-tooth" }
  },
  "toolCall": {
    "trigger": "\\bTOOL\\s+CALL\\s+(\\d|\"|QS\\d)",
    "tool": "TOOL\\s+CALL\\s+(?<tool>\\d+(?:\\.\\d(?!\\d))?|\"[^\"]+\"|QS\\d+)\\s*(?:(?<axis>[XYZ])(?![A-Z0-9_]))?",
    "toolFrom": "same-line"
  },
  "program": {
    "start": ["\\bBEGIN\\s+PGM\\s+(?<name>\\S+)"],
    "end": ["\\bEND\\s+PGM\\b"],
    "endRecord": true
  },
  "outline": [
    { "kind": "section", "pattern": "^\\s*(?:/\\s*)?\\d+\\s+(?:/\\s*)?\\*\\s*-?\\s*(?<text>.*)$" },
    { "kind": "comment", "pattern": "^\\s*(?:/\\s*)?\\d+\\s*(?:/\\s*)?;\\s*(?<text>.*)$" },
    { "kind": "program", "pattern": "^\\s*\\d+\\s+(?<text>BEGIN\\s+PGM\\s+(?<name>\\S+)(?:\\s+(?:MM|INCH))?)" },
    { "kind": "label", "pattern": "^\\s*\\d+\\s+(?:/\\s*)?(?<text>LBL\\s+(?<name>(?!0(?![\\d.]))\\S+))" },
    { "kind": "subprogram-call", "pattern": "\\b(?<text>(?:CALL\\s+(?:LBL|PGM)|SEL\\s+PGM)\\s+\\S+(?:\\s+REP\\s+\\S+)?)" },
    { "kind": "stop", "pattern": "\\b(STOP|M0?[01])\\b" },
    { "kind": "end", "pattern": "\\bEND\\s+PGM\\b|\\bM(?:30|2)\\b" }
  ],
  "numbering": { "mode": "consecutive", "start": 0, "step": 1 },
  "editing": { "forceUppercase": false, "preventLineJoin": true },
  "compare": {
    "ignoreBlockNumbers": true,
    "ignoreWhitespace": true,
    "ignoreComments": true,
    "ignoreCase": false,
    "ignoreNumberFormat": true,
    "ignoreCycleNames": false,
    "cycleNames": [
      "^\\s*(?:/\\s*)?\\d+\\s+(?:/\\s*)?CYCL\\s+DEF\\s+\\d+(?:\\.0+)?\\s+(?<name>(?![+\\-.\\d#\"(]|[A-Z]{1,2}[+\\-]?\\d|[A-Z](?![^\\s~;=]))[^\\s~;=]+(?:\\s+(?![+\\-.\\d#\"(]|[A-Z]{1,2}[+\\-]?\\d|[A-Z](?![^\\s~;=]))[^\\s~;=]+)*)\\s*(?:[~;]|$)",
      "^\\s*(?:/\\s*)?\\d+\\s+(?:/\\s*)?CYCL\\s+DEF\\s+\\d+\\.\\d*[1-9]\\d*\\s+(?<name>(?![+\\-.#\"(]|[A-Z](?![^\\s~;=\\d]))[^\\s~;=\\d]+(?:\\s+(?![+\\-.#\"(]|[A-Z](?![^\\s~;=\\d]))[^\\s~;=\\d]+)*)(?=\\s+[+\\-]?\\.?\\d)"
    ]
  }
}
