{
  "id": "sinumerik",
  "name": "Sinumerik 840D (turning)",
  "shortName": "Sinumerik",
  "version": 1,
  "machineType": "lathe",
  "grammar": "sinumerik",
  "codes": "sinumerik",
  "files": {
    "extensions": ["mpf", "spf"],
    "defaultExtension": "mpf",
    "filterName": "Sinumerik",
    "encoding": "keep",
    "lineEnding": "keep",
    "newFileLineEnding": "lf"
  },
  "detect": {
    "extensions": { "mpf": 8, "spf": 8 },
    "content": [
      { "pattern": "^%_N_\\w+_(?:MPF|SPF)", "weight": 5000 },
      { "pattern": "^;\\$PATH=", "weight": 5000 },
      { "pattern": "(?<![A-Z0-9_$])CYCLE\\d+(?![A-Z0-9_])", "weight": 4 },
      { "pattern": "=[ \\t]*(?:AC|IC|DC|ACP|ACN)[ \\t]*\\(", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])CR[ \\t]*=", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])(?:TRAORI|TRAFOOF|TRACYL|TRANSMIT|ORIWKS|ORIAXES|MCALL|SUPA)(?![A-Z0-9_])", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])WORKPIECE[ \\t]*\\(", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])T\\d*[ \\t]*=[ \\t]*\"", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])LIMS[ \\t]*=", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])DIAM(?:ON|OF|90)(?![A-Z0-9_])", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])G0*9[67](?![\\d.])", "weight": 4 },
      { "pattern": "(?<![A-Z0-9_$])MSG[ \\t]*\\([ \\t]*[\")]", "weight": 3 },
      { "pattern": "(?<![A-Z0-9_$])GOTO[FB](?![A-Z0-9_])", "weight": 3 },
      { "pattern": "(?<![A-Z0-9_$])DEF[ \\t]+(?:REAL|INT)(?![A-Z0-9_])", "weight": 3 },
      { "pattern": "(?<![A-Z0-9_$])[MST]\\d+[ \\t]*=", "weight": 3 },
      { "pattern": "(?<![A-Z0-9_$])G0*64[0-9](?![\\d.])", "weight": 2 },
      { "pattern": "^;", "weight": 1 },
      { "pattern": "^(?![^;]*(?<![A-Z_$])Y)N\\d+", "weight": 1 },
      { "pattern": "^(?![^;]*(?<![A-Z_$])Y)(?:N\\d+[ \\t]*)?[GM]\\d{1,3}(?![\\d.])", "weight": 1 }
    ],
    "priority": 0
  },
  "syntax": {
    "comments": [{ "start": ";", "end": null }],
    "strings": true,
    "blockSkip": { "chars": "/", "position": "before-number", "levels": true },
    "blockNumber": { "mode": "prefix", "prefix": "N", "altPrefixes": [], "mandatory": false },
    "decimalSeparator": ".",
    "decimalPointSignificant": false,
    "wordSeparatorRequired": false,
    "variables": "R\\d+",
    "systemVariables": "\\$[A-Z_][A-Z0-9_]*",
    "assignment": "[A-Z_][A-Z0-9_]*(?=\\s*=(?!=))",
    "labels": "^\\s*(?:/\\d?\\s*)?(?:N\\d+[ \\t]+)?(?<name>[A-Z_][A-Z0-9_]*):(?!=)",
    "calls": true,
    "header": "^%_N_\\w+_(?:MPF|SPF)",
    "names": "[A-Z_]{2}[A-Z0-9_]*",
    "keywords": [
      "IF",
      "ELSE",
      "ENDIF",
      "WHILE",
      "ENDWHILE",
      "FOR",
      "TO",
      "ENDFOR",
      "REPEAT",
      "REPEATB",
      "UNTIL",
      "LOOP",
      "ENDLOOP",
      "CASE",
      "OF",
      "DEFAULT",
      "GOTO",
      "GOTOF",
      "GOTOB",
      "GOTOC",
      "RET",
      "PROC",
      "EXTERN",
      "DEF",
      "CALL",
      "PCALL",
      "MCALL",
      "EXTCALL",
      "BLOCK",
      "AND",
      "OR",
      "NOT",
      "XOR",
      "DIV",
      "MOD",
      "B_AND",
      "B_OR",
      "B_XOR",
      "B_NOT",
      "TRAORI",
      "TRAFOOF",
      "TRANSMIT",
      "TRACYL",
      "TRAANG",
      "TRANS",
      "ATRANS",
      "ROT",
      "AROT",
      "RPL",
      "SCALE",
      "ASCALE",
      "MIRROR",
      "AMIRROR",
      "SUPA",
      "DIAMON",
      "DIAMOF",
      "DIAM90",
      "SOFT",
      "BRISK",
      "FFWON",
      "FFWOF",
      "COMPON",
      "COMPCURV",
      "COMPCAD",
      "COMPOF",
      "CUT2D",
      "CUT3DC",
      "CFC",
      "CFTCP",
      "CFIN",
      "ORIWKS",
      "ORIMKS",
      "ORIAXES",
      "ORIVECT",
      "STOPRE",
      "CIP",
      "CT",
      "AC",
      "IC",
      "DC",
      "ACP",
      "ACN",
      "INT",
      "REAL",
      "BOOL",
      "CHAR",
      "STRING",
      "AXIS",
      "FRAME"
    ],
    "maxLineLength": 512
  },
  "addresses": {
    "tool": "T",
    "feed": "F",
    "spindle": "S",
    "axes": ["X", "Z", "C", "Y"],
    "arcCenter": ["I", "J", "K"],
    "arcCenterMode": "incremental",
    "diameter": ["X"],
    "angular": ["C", "AR", "SF"],
    "speedLimitWords": ["LIMS"],
    "mainSpindle": "1"
  },
  "toolCall": {
    "trigger": "^(?:[^\"]*\"[^\"]*\")*[^\"]*?(?<![A-Z_$])T(?:\\d*\\s*=\\s*\"[^\"]*\"|\\d*\\s*=\\s*(?!0+(?![\\d.]))\\d+(?![\\d._])|(?!0+(?![\\d.]))\\d+(?![\\d._])(?!\\s*=))",
    "tool": "^(?:[^\"]*\"[^\"]*\")*[^\"]*?(?<![A-Z_$])T(?:\\d*\\s*=\\s*)?(?<tool>\\d+|\"[^\"]*\")",
    "toolFrom": "same-line"
  },
  "program": {
    "start": ["^%_N_(?<name>\\w+)_(?:MPF|SPF)", "^\\s*(?:N\\d+[ \\t]+)?PROC[ \\t]+(?<name>[A-Z_][A-Z0-9_]*)"],
    "end": ["(?<![A-Z_])M0*(?:2|30|17)(?![\\d.]|\\s*=)", "(?<![A-Z_])RET(?![A-Z0-9_])"]
  },
  "outline": [
    { "kind": "program", "pattern": "^%_N_(?<name>\\w+)_(?:MPF|SPF)" },
    { "kind": "program", "pattern": "^\\s*(?:N\\d+[ \\t]+)?PROC[ \\t]+(?<name>[A-Z_][A-Z0-9_]*)" },
    {
      "kind": "end",
      "pattern": "^\\s*(?:/\\d?[ \\t]*)?(?:N\\d+[ \\t]+)?(?<text>[A-Z_][A-Z0-9_]*:(?!=).*?(?<![A-Z_])(?:M0*(?:2|30|17)(?![\\d.]|\\s*=)|RET(?![A-Z0-9_])))"
    },
    { "kind": "label", "pattern": "^\\s*(?:/\\d?\\s*)?(?:N\\d+[ \\t]+)?(?<text>[A-Z_][A-Z0-9_]*):(?!=)" },
    { "kind": "comment", "pattern": "^\\s*;(?![-*=_\\s]*$)(?<text>.*)$" },
    { "kind": "comment", "pattern": "(?<![A-Z_])MSG\\s*\\(\\s*\"(?<text>[^\"]*)\"\\s*\\)" },
    {
      "kind": "subprogram-call",
      "pattern": "^\\s*(?:/\\d?[ \\t]*)?(?:N\\d+[ \\t]+)?(?:MCALL[ \\t]+)?(?!(?:AC|IC|DC|ACP|ACN|MSG|IF|WHILE|FOR|CASE|UNTIL|REPEATB|REPEAT|LOOP|GOTOF|GOTOB|GOTOC|GOTO|DEF|SETMS|SETM|CLEARM|WAITMC|WAITM|WAITE|TRAORI|TRANSMIT|TRACYL|TRAANG|EXTCALL|CALLPATH)[ \\t]*\\()(?<text>[A-Z_][A-Z0-9_]*(?=\\()|[A-Z_]{2}[A-Z0-9_]*(?=[ \\t]+\\())[ \\t]*\\("
    },
    {
      "kind": "subprogram-call",
      "pattern": "(?<![A-Z_])(?<text>EXTCALL(?:[ \\t]*\\([ \\t]*(?:\"[^\"]*\"|[A-Z_][A-Z0-9_]*)[ \\t]*\\)|[ \\t]+\"[^\"]*\")|(?:PCALL|ISOCALL|CALL)(?:[ \\t]+(?:\"[^\"]*\"|[A-Z0-9_/]+)|[ \\t]*/[A-Z0-9_/]+)|L\\d+(?![\\d.]))"
    },
    {
      "kind": "subprogram-call",
      "pattern": "^\\s*(?:/\\d?[ \\t]*)?(?:N\\d+[ \\t]+)?(?=[A-Z_]*[0-9_]|[A-Z_][A-Z0-9_]*[ \\t]+P\\d)(?!(?:CUT3DC|DIAM90|B_AND|B_NOT|B_XOR|CUT2D|B_OR|CUT2DF|CUT3DFS|CUT3DFF|CUT3DF|CDOF2|ORIRPY2|WALCS\\d+)(?![A-Z0-9_]))(?<text>(?:[A-Z]{2}|_[A-Z])[A-Z0-9_]*(?:[ \\t]+P\\d+)?)[ \\t]*$"
    },
    { "kind": "stop", "pattern": "(?<![A-Z_])M0*[01](?![\\d.]|\\s*=)" },
    { "kind": "end", "pattern": "(?<![A-Z_])(?:M0*(?:2|30|17)(?![\\d.]|\\s*=)|RET(?![A-Z0-9_]))" }
  ],
  "numbering": {
    "mode": "free",
    "start": 10,
    "step": 10,
    "digits": 0,
    "max": 2147483647,
    "onOverflow": "stop",
    "spacesAfter": 1,
    "skipStartingWith": ["%", ";", "PROC", "DEF", "EXTERN"],
    "skipEmpty": true,
    "restartAtProgramStart": true,
    "references": [{ "trigger": "(?<![A-Z_])GOTO[FBC]?(?![A-Z0-9_])", "addresses": ["N"] }]
  },
  "modal": { "initial": { "plane": "G18", "feedmode": "G95" } },
  "machineParams": {
    "numberInput": {
      "default": "calculator",
      "presets": [
        {
          "id": "calculator",
          "label": "As written, the only reading in Siemens mode: X50 and X50. are both 50 mm, F0.2 is 0.2 mm/rev, G4 F2 waits 2 s",
          "source": "syntax-sinumerik.md \u00a73.3",
          "value": {
            "mode": "calculator",
            "incrementMm": "1",
            "incrementInch": "1",
            "incrementDeg": "1",
            "incrementSec": "1"
          }
        }
      ]
    },
    "units": "mm",
    "diameter": "on",
    "modalGroups": ["feedmode", "plane", "distance"]
  },
  "toolList": { "description": "auto", "commentFilter": "^[-*=_\\s]*$", "dropLeadingZeros": true }
}
