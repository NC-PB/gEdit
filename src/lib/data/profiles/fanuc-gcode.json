{
  "id": "fanuc-gcode",
  "name": "Fanuc (ISO) mill",
  "shortName": "Fanuc",
  "version": 1,
  "machineType": "mill",
  "grammar": "iso",
  "codes": "fanuc",
  "files": {
    "extensions": ["nc", "tap", "cnc", "eia", "iso", "min", "ncc", "ptp", "txt"],
    "defaultExtension": "nc",
    "filterName": "Fanuc G-Code",
    "encoding": "keep",
    "lineEnding": "keep",
    "newFileLineEnding": "crlf"
  },
  "detect": {
    "extensions": { "nc": 3, "tap": 3, "cnc": 2, "eia": 2, "iso": 2, "min": 2 },
    "content": [
      { "pattern": "^\\s*%\\s*$", "weight": 5 },
      { "pattern": "^\\s*[O:]\\d{1,8}(?!\\d)", "weight": 5 },
      { "pattern": "^\\s*N\\d+", "weight": 1 },
      { "pattern": "^\\s*(N\\d+\\s*)?[GM]\\d{1,3}(\\.\\d)?(?![\\d.])", "weight": 1 },
      { "pattern": "^\\s*\\([^)]*\\)\\s*$", "weight": 1 },
      { "pattern": "(?<![A-Z])M0*6(?!\\d)", "weight": 3 },
      { "pattern": "(?<![A-Z])G0*4[34](?![\\d.])(?=[^(]*H\\d)", "weight": 3 },
      { "pattern": "(?<![A-Z])G0*17(?![\\d.])", "weight": 1 },
      { "pattern": "(?<![A-Z])Y[-+]?\\.?\\d", "weight": 1 }
    ],
    "priority": 1
  },
  "syntax": {
    "comments": [{ "start": "(", "end": ")" }],
    "blockSkip": { "chars": "/", "position": "either", "levels": true },
    "blockNumber": { "mode": "prefix", "prefix": "N", "altPrefixes": [], "mandatory": false },
    "decimalSeparator": ".",
    "decimalPointSignificant": true,
    "wordSeparatorRequired": false,
    "variables": "#\\d+",
    "keywords": ["GOTO", "IF", "THEN", "WHILE", "DO", "END", "EQ", "NE", "GT", "LT", "GE", "LE", "AND", "OR", "XOR", "MOD"]
  },
  "addresses": {
    "tool": "T",
    "feed": "F",
    "spindle": "S",
    "axes": ["X", "Y", "Z", "A", "B", "C", "U", "V", "W"],
    "arcCenter": ["I", "J", "K"],
    "arcCenterMode": "incremental"
  },
  "toolCall": {
    "trigger": "(?<![A-Z])M0*6(?!\\d)",
    "tool": "(?<![A-Z])T(?<tool>\\d+)",
    "toolFrom": "same-line-or-last"
  },
  "program": {
    "start": ["^\\s*O(?<name>\\d+)", "^\\s*:(?<name>\\d+)"],
    "end": ["(?<![A-Z])M0*(30|2)(?!\\d)"]
  },
  "outline": [
    { "kind": "program", "pattern": "^\\s*[O:](?<name>\\d+)" },
    { "kind": "comment", "pattern": "^\\s*\\((?<text>[^)]*)\\)\\s*$" },
    { "kind": "stop", "pattern": "(?<![A-Z])M0*[01](?!\\d)" },
    { "kind": "subprogram-call", "pattern": "(?<![A-Z])(?<text>M0*98\\s*[PQ]\\d+(?:\\s*L\\d+)?|G0*65\\s*P\\d+)" },
    { "kind": "end", "pattern": "(?<![A-Z])M0*(?:30|2|99)(?!\\d)" }
  ],
  "numbering": {
    "start": 10,
    "step": 10,
    "digits": 0,
    "max": 99999,
    "onOverflow": "wrap",
    "spacesAfter": 1,
    "skipStartingWith": ["%", "O", "("],
    "skipEmpty": true,
    "restartAtProgramStart": true,
    "references": [
      { "trigger": "(?<![A-Z])M\\s*0*99(?!\\d)", "addresses": ["P"], "rewrite": false },
      { "trigger": "^(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)", "addresses": ["Q"] },
      { "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)", "addresses": ["Q"], "rewrite": false },
      { "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])G\\s*0*7[0-3](?![\\d.])", "addresses": ["P", "Q"], "rewrite": false },
      { "trigger": "(?<![A-Z])GOTO", "addresses": ["GOTO"] }
    ]
  },
  "modal": { "initial": { "feedmode": "G94" } },
  "machineParams": {
    "numberInput": {
      "default": "is-b",
      "presets": [
        {
          "id": "is-b",
          "label": "Increments of 0.001 mm (IS-B): X50 is 0.050 mm, X50. is 50 mm; feeds and speeds as written (F200 is 200)",
          "source": "syntax-fanuc.md \u00a73.2",
          "verify": true,
          "value": {
            "mode": "increment",
            "incrementMm": "0.001",
            "incrementInch": "0.0001",
            "incrementDeg": "0.001",
            "incrementSec": "0.001",
            "classes": {
              "feedPerMin": { "mode": "calculator" },
              "feedPerRev": { "mode": "calculator" }
            }
          }
        },
        {
          "id": "is-c",
          "label": "Increments of 0.0001 mm (IS-C): X50 is 0.0050 mm, X50. is 50 mm; feeds and speeds as written (F200 is 200)",
          "source": "syntax-fanuc.md \u00a73.2",
          "verify": true,
          "value": {
            "mode": "increment",
            "incrementMm": "0.0001",
            "incrementInch": "0.00001",
            "incrementDeg": "0.0001",
            "incrementSec": "0.0001",
            "classes": {
              "feedPerMin": { "mode": "calculator" },
              "feedPerRev": { "mode": "calculator" }
            }
          }
        },
        {
          "id": "calculator",
          "label": "As written: X50 and X50. are both 50 mm; cycle steps in microns (Q6000 is 6 mm)",
          "source": "syntax-fanuc.md \u00a73.2",
          "verify": true,
          "value": { "mode": "calculator", "incrementMm": "0.001" }
        }
      ]
    },
    "units": "mm",
    "modalGroups": ["feedmode", "distance", "plane"]
  },
  "editing": { "forceUppercase": true, "preventLineJoin": true, "tabWidth": 4 },
  "onLoad": { "stripNul": true },
  "compare": {
    "ignoreBlockNumbers": true,
    "ignoreWhitespace": true,
    "ignoreComments": false,
    "ignoreCase": true,
    "ignoreNumberFormat": true,
    "tolerance": 0
  },
  "toolList": { "description": "auto", "commentFilter": "^[-*=_\\s]*$", "dropLeadingZeros": true }
}
