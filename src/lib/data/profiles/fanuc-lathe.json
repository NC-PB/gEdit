{
  "id": "fanuc-lathe",
  "extends": "fanuc-gcode",
  "name": "Fanuc (ISO) lathe",
  "shortName": "Fanuc T",
  "version": 1,
  "machineType": "lathe",
  "codes": "fanuc-lathe",
  "files": { "filterName": "Fanuc lathe G-Code" },
  "detect": {
    "extensions": { "nc": 3, "tap": 3, "cnc": 2, "eia": 2, "iso": 2 },
    "content": [
      { "pattern": "^\\s*%\\s*$", "weight": 5 },
      { "pattern": "^\\s*[O:]\\d{1,8}(?!\\d)", "weight": 5 },
      { "pattern": "^\\s*N\\d+", "weight": 1 },
      { "pattern": "^\\s*(N\\d+\\s*)?[GM]\\d{1,3}(\\.\\d)?(?![\\d.])", "weight": 1 },
      { "pattern": "^\\s*\\([^)]*\\)\\s*$", "weight": 1 },
      { "pattern": "(?<![A-Z])T\\d{4,5}(?!\\d)", "weight": 3 },
      { "pattern": "(?<![A-Z])G0*50\\s*S\\d", "weight": 4 },
      { "pattern": "(?<![A-Z])G0*92\\s*S\\d", "weight": 4 },
      { "pattern": "(?<![A-Z])G0*9[67](?![\\d.])", "weight": 4 },
      { "pattern": "(?<![A-Z])G0*7[0-3](?![\\d.])(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)", "weight": 6 },
      { "pattern": "(?<![A-Z])G0*7[12]\\s*U[\\d.]+\\s*R", "weight": 6 },
      { "pattern": "^(?![^(]*(?<![A-Z])G0*91(?![\\d.]))[^(]*?(?<![A-Z])G0*(?:28|30)(?![\\d.])[ \\t]*(?:(?:P\\d[ \\t]*)?(?:W[-+]?[.\\d]+[ \\t]*)?[UVH]|W)[-+]?[.\\d]", "weight": 4 },
      { "pattern": "(?<![A-Z])[UW][-+]?\\.?\\d", "weight": 1 }
    ],
    "priority": 0
  },
  "addresses": {
    "axes": ["X", "Z", "C", "Y", "U", "W"],
    "arcCenter": ["I", "K"],
    "diameter": ["X", "U"],
    "angular": ["C"]
  },
  "toolCall": {
    "trigger": "(?<![A-Z])T\\d{1,5}(?!\\d)",
    "ignore": "(?<![A-Z])T(?:\\d{0,3}00|0+)(?!\\d)",
    "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)(?:\\d{2})?(?!\\d)",
    "toolFrom": "same-line"
  },
  "modal": { "initial": { "feedmode": "G99", "spindlemode": "G97", "plane": "G18" } },
  "syntax": { "decimalPointSignificant": false },
  "machineParams": {
    "numberInput": {
      "default": "calculator",
      "presets": [
        {
          "id": "is-b",
          "label": "Increments of 0.001 mm (IS-B): X50 is 0.050 mm, X50. is 50 mm, C90000 is 90\u00b0; a point-less feed per minute in 1 mm/min (F200 is 200), per revolution in 0.01 mm/rev (F25 is 0.25 mm/rev)",
          "source": "syntax-fanuc.md \u00a73.2",
          "verify": true,
          "value": {
            "mode": "increment",
            "incrementMm": "0.001",
            "incrementInch": "0.0001",
            "incrementDeg": "0.001",
            "incrementSec": "0.001",
            "classes": {
              "feedPerMin": { "mode": "increment", "increment": "1", "incrementInch": "0.01" },
              "feedPerRev": { "mode": "increment", "increment": "0.01", "incrementInch": "0.0001" }
            }
          }
        },
        {
          "id": "is-c",
          "label": "Increments of 0.0001 mm (IS-C): X50 is 0.0050 mm, X50. is 50 mm; a point-less feed per minute in 1 mm/min (F200 is 200), per revolution in 0.01 mm/rev (F25 is 0.25 mm/rev)",
          "source": "syntax-fanuc.md \u00a73.2",
          "verify": true,
          "value": {
            "mode": "increment",
            "incrementMm": "0.0001",
            "incrementInch": "0.00001",
            "incrementDeg": "0.0001",
            "incrementSec": "0.0001",
            "classes": {
              "feedPerMin": { "mode": "increment", "increment": "1", "incrementInch": "0.01" },
              "feedPerRev": { "mode": "increment", "increment": "0.01", "incrementInch": "0.0001" }
            }
          }
        },
        {
          "id": "calculator",
          "label": "As written: X50 and X50. are both 50 mm; G74/G75 P and Q, G76 Q and G83/G87 Q are in microns (Q6000 is 6 mm)",
          "source": "syntax-fanuc.md \u00a73.2",
          "verify": true,
          "value": { "mode": "calculator", "incrementMm": "0.001" }
        }
      ]
    },
    "diameter": "on",
    "modalGroups": ["feedmode", "spindlemode", "plane"],
    "variants": [
      {
        "id": "gcodeSystem",
        "label": "G-code system",
        "default": "A",
        "choices": [
          {
            "value": "A",
            "label": "G-code system A",
            "codes": "fanuc-lathe",
            "detect": [
              { "pattern": "(?<![A-Z])G0*50\\s*S\\d", "weight": 4 },
              { "pattern": "(?<![A-Z])G0*9[89](?![\\d.])", "weight": 2 }
            ]
          },
          {
            "value": "B",
            "label": "G-code system B",
            "codes": "fanuc-lathe-b",
            "overlay": { "modal": { "initial": { "feedmode": "G95" } } },
            "detect": [
              { "pattern": "(?<![A-Z])G0*92\\s*S\\d", "weight": 5 },
              { "pattern": "(?<![A-Z])G0*7[789](?![\\d.])", "weight": 5 },
              { "pattern": "(?<![A-Z])G0*9[45](?![\\d.])", "weight": 2 }
            ]
          }
        ]
      },
      {
        "id": "incrementalAddresses",
        "label": "U, W, V and H move incrementally",
        "default": "uw",
        "choices": [
          {
            "value": "uw",
            "label": "U and W are incremental X and Z (default, verify)",
            "overlay": { "addresses": { "incremental": { "U": "X", "W": "Z" } } }
          },
          {
            "value": "uwvh",
            "label": "U, W, V and H are incremental X, Z, Y and C",
            "overlay": { "addresses": { "incremental": { "U": "X", "W": "Z", "V": "Y", "H": "C" } } }
          },
          {
            "value": "none",
            "label": "None of them: G91 is the only incremental mode",
            "overlay": { "addresses": { "diameter": ["X"] } }
          }
        ]
      },
      {
        "id": "toolWord",
        "label": "Tool word: offset digits",
        "default": "offset2",
        "choices": [
          {
            "value": "offset2",
            "label": "The last two digits are the offset: T0101 (default, verify)",
            "overlay": {
              "toolCall": {
                "trigger": "(?<![A-Z])T\\d{1,5}(?!\\d)",
                "ignore": "(?<![A-Z])T(?:\\d{0,3}00|0+)(?!\\d)",
                "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)(?:\\d{2})?(?!\\d)"
              }
            }
          },
          {
            "value": "offset1",
            "label": "The last digit is the offset: T11",
            "overlay": {
              "toolCall": {
                "trigger": "(?<![A-Z])T\\d{1,4}(?!\\d)",
                "ignore": "(?<![A-Z])T(?:\\d{0,3}0|0+)(?!\\d)",
                "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)\\d?(?!\\d)"
              }
            }
          },
          {
            "value": "offset3",
            "label": "The last three digits are the offset: T1001",
            "overlay": {
              "toolCall": {
                "trigger": "(?<![A-Z])T\\d{1,6}(?!\\d)",
                "ignore": "(?<![A-Z])T(?:\\d{0,3}000|0+)(?!\\d)",
                "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)(?:\\d{3})?(?!\\d)"
              }
            }
          }
        ]
      }
    ],
    "channels": {
      "waitLetters": [
        "M"
      ],
      "presets": [
        {
          "id": "fanuc-2path",
          "label": "Two paths, one file per path (path number at the end of the extension); waits M900-M999; P as a bit sum (the control's default, P3 = paths 1 and 2); no P = paths 1 and 2",
          "source": "Fanuc 30i/31i user manual, multi-path waiting function (parameters 8110, 8111, 8103 bit 1); the range M900-M999 from the owner's local multi-path set (aggregate)",
          "verify": true,
          "value": {
            "layout": "multi-file",
            "list": [
              {
                "id": "1",
                "name": "Path 1"
              },
              {
                "id": "2",
                "name": "Path 2"
              }
            ],
            "fileName": "^(?<stem>.+)\\.[A-Za-z]*-?(?<channel>\\d{1,2})$",
            "syncMarks": [
              {
                "id": "wait",
                "label": "Waiting M-code: the range is parameters 8110/8111, the P word names the paths",
                "samePartners": true,
                "match": {
                  "kind": "codes",
                  "codes": "M900-M999"
                },
                "partners": {
                  "kind": "word",
                  "address": "P",
                  "decode": "bitmask",
                  "whenAbsent": {
                    "kind": "fixed",
                    "channels": [
                      "1",
                      "2"
                    ]
                  }
                }
              }
            ],
            "stopsAndEndsWait": false
          }
        },
        {
          "id": "fanuc-2path-digits",
          "label": "Two paths, one file per path (path number at the end of the extension); waits M900-M999; P as path numbers (parameter 8103 bit 1 = 1, P12 = paths 1 and 2); no P = paths 1 and 2",
          "source": "Fanuc 30i/31i user manual, multi-path waiting function (parameters 8110, 8111; 8103 bit 1 = 1: P as path numbers; without P, paths 1 and 2 wait)",
          "verify": true,
          "value": {
            "layout": "multi-file",
            "list": [
              {
                "id": "1",
                "name": "Path 1"
              },
              {
                "id": "2",
                "name": "Path 2"
              }
            ],
            "fileName": "^(?<stem>.+)\\.[A-Za-z]*-?(?<channel>\\d{1,2})$",
            "syncMarks": [
              {
                "id": "wait",
                "label": "Waiting M-code: the range is parameters 8110/8111, the P word names the paths",
                "samePartners": true,
                "match": {
                  "kind": "codes",
                  "codes": "M900-M999"
                },
                "partners": {
                  "kind": "word",
                  "address": "P",
                  "decode": "digits",
                  "whenAbsent": {
                    "kind": "fixed",
                    "channels": [
                      "1",
                      "2"
                    ]
                  }
                }
              }
            ],
            "stopsAndEndsWait": false
          }
        },
        {
          "id": "fanuc-3path-digits",
          "label": "Three paths, one file per path (path number at the end of the extension); waits M900-M999; P as path numbers (P12 = paths 1 and 2, 0 = path 10); a wait without P is an error",
          "source": "Fanuc 30i/31i user manual, multi-path waiting function (parameter 8103 bit 1 = 1; without P only two-path systems wait); the owner's local three-path set writes digit P words (aggregate)",
          "verify": true,
          "value": {
            "layout": "multi-file",
            "list": [
              {
                "id": "1",
                "name": "Path 1"
              },
              {
                "id": "2",
                "name": "Path 2"
              },
              {
                "id": "3",
                "name": "Path 3"
              }
            ],
            "fileName": "^(?<stem>.+)\\.[A-Za-z]*-?(?<channel>\\d{1,2})$",
            "syncMarks": [
              {
                "id": "wait",
                "label": "Waiting M-code: the range is parameters 8110/8111, the P word names the paths",
                "samePartners": true,
                "match": {
                  "kind": "codes",
                  "codes": "M900-M999"
                },
                "partners": {
                  "kind": "word",
                  "address": "P",
                  "decode": "digits",
                  "whenAbsent": {
                    "kind": "none"
                  }
                }
              }
            ],
            "stopsAndEndsWait": false
          }
        },
        {
          "id": "fanuc-3path-bitmask",
          "label": "Three paths, one file per path (path number at the end of the extension); waits M900-M999; P as a bit sum (P7 = paths 1, 2 and 3); a wait without P is an error",
          "source": "Fanuc 30i/31i user manual, multi-path waiting function (parameter 8103 bit 1 = 0)",
          "verify": true,
          "value": {
            "layout": "multi-file",
            "list": [
              {
                "id": "1",
                "name": "Path 1"
              },
              {
                "id": "2",
                "name": "Path 2"
              },
              {
                "id": "3",
                "name": "Path 3"
              }
            ],
            "fileName": "^(?<stem>.+)\\.[A-Za-z]*-?(?<channel>\\d{1,2})$",
            "syncMarks": [
              {
                "id": "wait",
                "label": "Waiting M-code: the range is parameters 8110/8111, the P word names the paths",
                "samePartners": true,
                "match": {
                  "kind": "codes",
                  "codes": "M900-M999"
                },
                "partners": {
                  "kind": "word",
                  "address": "P",
                  "decode": "bitmask",
                  "whenAbsent": {
                    "kind": "none"
                  }
                }
              }
            ],
            "stopsAndEndsWait": false
          }
        }
      ]
    }
  },
  "numbering": {
    "references": [
      { "trigger": "(?<![A-Z])M\\s*0*99(?!\\d)", "addresses": ["P"], "rewrite": false },
      { "trigger": "^(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)", "addresses": ["Q"] },
      { "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)", "addresses": ["Q"], "rewrite": false },
      { "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])G\\s*0*7[0-3](?![\\d.])", "addresses": ["P", "Q"] },
      { "trigger": "(?<![A-Z])GOTO", "addresses": ["GOTO"] }
    ]
  },
  "toolList": { "description": "auto", "commentFilter": "^[-*=_\\s]*$", "dropLeadingZeros": true }
}
