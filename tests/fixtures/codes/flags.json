  "droppedByOverride": {
    "fanuc-lathe": [
      {"code": "G50", "why": "By design. The lathe-A G50 sets the coordinate system with X and Z (data) and clamps the spindle speed with S; it does not end a scaling, so it closes no frame."},
      {"code": "G68", "why": "By design. On the lathe the number is the mirror image for the second turret, which has no centre or angle words; the mill's G68 carries the centre of the rotation."},
      {"code": "G92", "why": "By design. In G-code system A the number is the threading cycle: X and Z are the end of the pass, positions in the program's frame."}
    ]
