%_N_GROOVE_SPF
; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
;$PATH=/_N_WKS_DIR/_N_SHAFT_WPD
PROC GROOVE(REAL XBOT, REAL ZPOS, INT PECKS)
DEF REAL XNOW
DEF INT COUNT
N10 MSG("GROOVE IN PECKS")
N20 R10=0.5
N30 XNOW=62
N40 COUNT=0
N50 G0 X62 Z=ZPOS
NEXT_PECK:
N60 XNOW=XNOW-2*R10
N70 IF XNOW<=XBOT GOTOF LAST_CUT
N80 G1 X=XNOW F0.05
N90 G0 X=XNOW+1
N100 COUNT=COUNT+1
N110 IF COUNT<PECKS GOTOB NEXT_PECK
LAST_CUT:
N120 G1 X=XBOT F0.05
N130 G4 F0.3
N140 G0 X62
N150 MSG()
N160 L20
N170 L30 P2
N180 CALL "PROBE_CYCLE"
N190 EXTCALL "GROOVE_FINISH"
N200 PROBE_DIA(1,,3)
N210 M17
