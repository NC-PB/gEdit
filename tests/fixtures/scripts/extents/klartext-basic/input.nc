0 BEGIN PGM EXT MM
; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 1 Z S3000
5 L Z+100 R0 FMAX
6 L X-10 Y+50 R0 FMAX
7 L Z-5 R0 F500
8 CC X+50 Y+50
9 L X+0 Y+50 RL F300
10 C X+0 DR-
11 CR X+20 Y+30 R+20 DR+
12 L IX+5 IZ+105 R0 FMAX
13 L Z+250 R0 FMAX M91
14 TOOL CALL 2 Z S2000
15 CYCL DEF 200 DRILLING ~
  Q200=+2 ;SET-UP CLEARANCE ~
  Q201=-15 ;DEPTH ~
  Q206=+150 ;FEED RATE FOR PLNGNG ~
  Q202=+5 ;PLUNGING DEPTH ~
  Q210=+0 ;DWELL TIME AT TOP ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=+50 ;2ND SET-UP CLEARANCE ~
  Q211=+0 ;DWELL TIME AT DEPTH
16 L X+10 Y+10 R0 FMAX M99
17 L X+20 R0 FMAX M99
18 CYCL CALL POS X+30 Y+10 Z+0 FMAX
19 PLANE SPATIAL SPA+0 SPB+45 SPC+0 TURN FMAX
20 L X+5 Y+5 FMAX
21 PLANE RESET STAY
22 L X+1,5 Y+1 Z+Q5 FMAX
23 END PGM EXT MM
