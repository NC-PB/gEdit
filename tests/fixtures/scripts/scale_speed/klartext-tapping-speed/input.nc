0 BEGIN PGM TAPS MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 5 Z S500
5 L Z+100 R0 FMAX M3
6 CYCL DEF 207 GEWINDEBOHREN GS ~
  Q200=+2 ;SICHERHEITS-ABST. ~
  Q201=-15 ;TIEFE ~
  Q239=+1.5 ;GEWINDESTEIGUNG ~
  Q203=+0 ;KOOR. OBERFLAECHE ~
  Q204=+50 ;2. SICHERHEITS-ABST.
7 L X+20 Y+20 R0 FMAX M99
8 TOOL CALL S450
9 L X+40 Y+20 R0 FMAX M99
10 CYCL CALL
11 L Z+100 R0 FMAX
12 TOOL CALL 6 Z S3000
13 CYCL DEF 200 BOHREN ~
  Q200=+2 ;SICHERHEITS-ABST. ~
  Q201=-10 ;TIEFE ~
  Q206=+150 ;VORSCHUB TIEFENZ. ~
  Q202=+5 ;ZUSTELL-TIEFE ~
  Q210=+0 ;VERWEILZEIT OBEN ~
  Q203=+0 ;KOOR. OBERFLAECHE ~
  Q204=+50 ;2. SICHERHEITS-ABST. ~
  Q211=+0 ;VERWEILZEIT UNTEN ~
  Q395=+0 ;BEZUG TIEFE
14 L X+60 Y+20 R0 FMAX M99
15 L Z+100 R0 FMAX M30
16 END PGM TAPS MM
