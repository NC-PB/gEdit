%_N_FLANGE_MPF
; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
;$PATH=/_N_WKS_DIR/_N_FLANGE_WPD
; FLANGE - CENTRE HOLE, THEN FACE HOLES AND THREADS WITH DRIVEN TOOLS
N10 G18 G90 G95 G40 G500 DIAMON
N20 G54
N30 MSG("CENTRE HOLE D10")
N40 T="DRILL_D10" D1
N50 G97 S1280 M3
N60 G17 G0 X0 Z5 M8
N70 F0.12
N80 CYCLE83(5,0,2,-30,,-8,,2,0,0.5,1,0)
N90 G18 G0 X200 Z200 M9
N100 MSG("FACE HOLES D8")
N110 T="DRILL_D8" D1
N120 M5
N130 SPOS=0
N140 DIAMOF
N150 TRANSMIT
N160 G17 G94
N170 S3=2400 M3=3
N180 G0 X30 Y0 Z5 M8
N190 F120
N200 MCALL CYCLE83(5,0,2,-18,,-5,,2,0,0.5,1,0)
N210 X30 Y0
N220 X-15 Y25.981
N230 X-15 Y-25.981
N240 MCALL
N250 G0 Z50 M9
N260 M3=5
N270 MSG("THREAD M10")
N280 T="TAP_M10" D1
N290 SETMS(3)
N300 S500 M3
N310 G0 X30 Y0 Z5 M8
N320 CYCLE84(5,0,2,-15,,0.5,3,,1.5,,500,500)
N330 G0 X-15 Y25.981
N340 CYCLE84(5,0,2,-15,,0.5,3,,1.5,,500,500)
N350 G0 X-15 Y-25.981
N360 CYCLE84(5,0,2,-15,,0.5,3,,1.5,,500,500)
N370 G0 Z50 M9
N380 M5
N390 SETMS(1)
N400 TRAFOOF
N410 DIAMON
N420 G18 G95
N430 G0 X200 Z200
N440 M30
