0 BEGIN PGM SF11 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 * - RIGID TAP M8X1.25
3 TOOL CALL 7 Z S600
4 L Z+100 R0 FMAX M3
5 CYCL DEF 207 RIGID TAPPING ~
   Q200=2 ;CLEARANCE ~
   Q201=-12 ;THREAD DEPTH ~
   Q239=+1.25 ;THREAD PITCH ~
   Q203=+0 ;SURFACE ~
   Q204=50 ;2ND CLEARANCE
6 L X+10 Y+10 R0 FMAX M99
7 * - TAP WITH A FLOATING HOLDER
8 CYCL DEF 206 TAPPING ~
   Q200=2 ;CLEARANCE ~
   Q201=-12 ;THREAD DEPTH ~
   Q206=750 ;PLUNGE FEED ~
   Q211=0 ;DWELL BOTTOM ~
   Q203=+0 ;SURFACE ~
   Q204=50 ;2ND CLEARANCE
9 L X+30 Y+10 R0 FMAX M99
10 L Z-2 R0 F500
11 L Z+100 R0 FMAX M9
12 M30
13 END PGM SF11 MM
