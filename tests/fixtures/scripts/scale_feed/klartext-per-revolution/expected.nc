0 BEGIN PGM SF10 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 * - DRILL WITH A NUMERIC Q206
4 TOOL CALL 6 Z S2000 F440
5 L Z+100 R0 FMAX M3
6 CYCL DEF 200 DRILLING ~
   Q200=2 ;CLEARANCE ~
   Q201=-20 ;DEPTH ~
   Q206=180 ;PLUNGE FEED ~
   Q202=4 ;PECK ~
   Q203=+0 ;SURFACE ~
   Q204=50 ;2ND CLEARANCE
7 L X+10 Y+10 R0 FMAX M99
8 * - MILL AT F800 ; NOT A COMMENT FEED
9 L Z-2 R0 F880
10 L X+60 FAUTO
11 L Y+40 FZ0.06
12 L X-10 FU0.13
13 L IY+5 F550
14 L Z+100 R0 FMAX M9
15 M30
16 END PGM SF10 MM
