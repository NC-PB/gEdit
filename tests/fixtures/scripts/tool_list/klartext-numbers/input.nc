0 BEGIN PGM TL01 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X-50 Y-40 Z-20
3 BLK FORM 0.2 X+50 Y+40 Z+0
4 * - ROUGH
5 TOOL CALL 1 Z S3000 F800 ; D10 END MILL
6 L Z+100 R0 FMAX M3
7 L Z-2 R0 F300
8 L X+60 R0 F800
9 * - DRILL
10 ; FOUR HOLES D8.5
11 TOOL CALL 2 Z S2400
12 L Z+100 R0 FMAX M3
13 CYCL DEF 200 DRILLING ~
   Q200=2 ;CLEARANCE ~
   Q201=-15 ;DEPTH ~
   Q206=150 ;PLUNGE FEED
14 L X-30 Y-20 R0 FMAX M99
15 TOOL CALL 1 Z S3200 F900 ; D10 END MILL
16 L Z+100 R0 FMAX M9
17 M30
18 END PGM TL01 MM
