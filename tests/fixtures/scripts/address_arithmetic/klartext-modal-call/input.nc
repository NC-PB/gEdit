0 BEGIN PGM AA11 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 TOOL CALL 1 Z S3000
3 CYCL DEF 200 DRILLING ~
  Q200=2 ;CLEARANCE ~
  Q201=-10 ;DEPTH ~
  Q206=150 ;PLUNGE FEED ~
  Q202=5 ;PECK ~
  Q210=0 ;DWELL TOP ~
  Q203=+0,5 ;SURFACE ~
  Q204=50 ;2ND CLEARANCE
4 L X+10 Y+10 Z+5 R0 FMAX M89
5 L X+20 Y+20 R0 FMAX
6 L X+30 Y+30 R0 FMAX M99
7 L Z+100 R0 FMAX
8 PLANE SPATIAL SPA+0 SPB+30 SPC+0 TURN MB MAX FMAX
9 L Z+50 R0 FMAX
10 PLANE RESET STAY
11 L Z+100 R0 FMAX M30
12 END PGM AA11 MM
