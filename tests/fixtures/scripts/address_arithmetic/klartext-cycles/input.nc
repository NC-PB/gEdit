0 BEGIN PGM AA10 MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 BLK FORM 0.1 Z X+0 Y+0 Z-20
3 BLK FORM 0.2 X+100 Y+100 Z+0
4 TOOL CALL 1 Z S3000
5 L Z+100 R0 FMAX M3
6 CYCL DEF 200 DRILLING ~
  Q200=2 ;CLEARANCE ~
  Q201=-10 ;DEPTH ~
  Q206=150 ;PLUNGE FEED ~
  Q202=5 ;PECK ~
  Q210=0 ;DWELL TOP ~
  Q203=+0 ;SURFACE ~
  Q204=50 ;2ND CLEARANCE ~
  Q211=0 ;DWELL BOTTOM ~
  Q395=0 ;DEPTH REFERENCE
7 L X+10 Y+10 R0 FMAX M99
8 L X+20 Y+10 R0 FMAX M99
9 CYCL DEF 200 DRILLING ~
  Q200=2 ;CLEARANCE ~
  Q201=-5 ;DEPTH ~
  Q206=150 ;PLUNGE FEED ~
  Q202=5 ;PECK ~
  Q210=0 ;DWELL TOP ~
  Q203=-2 ;SURFACE ~
  Q204=50 ;2ND CLEARANCE ~
  Q211=0 ;DWELL BOTTOM ~
  Q395=0 ;DEPTH REFERENCE
10 CYCL CALL POS X+40 Y+40 Z+0 FMAX
11 CYCL DEF 275 TROCHOIDAL SLOT ~
  Q203=+0 ;SURFACE
12 CYCL CALL
13 CYCL DEF 200 DRILLING ~
  Q201=-5 ;DEPTH ~
  Q203=+Q10 ;SURFACE ~
  Q204=50 ;2ND CLEARANCE
14 L X+60 Y+60 R0 FMAX M99
15 L IZ+5 R0 FMAX
16 L Z-5 R0 FMAX M91
17 L Z+100 R0 FMAX M30
18 END PGM AA10 MM
