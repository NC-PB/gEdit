0 BEGIN PGM POCKETS MM
1 ; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
2 TOOL CALL 1 Z S3000
3 L Z+100.5 R0 FMAX M3
4 CYCL DEF 251 RECTANGULAR POCKET ~
  Q215=0 ;MACHINING OPERATION ~
  Q218=80 ;FIRST SIDE LENGTH ~
  Q219=60 ;2ND SIDE LENGTH ~
  Q220=5 ;CORNER RADIUS ~
  Q368=0.2 ;ALLOWANCE FOR SIDE ~
  Q224=+0 ;ANGLE OF ROTATION ~
  Q367=0 ;POCKET POSITION ~
  Q207=500 ;FEED RATE FOR MILLNG ~
  Q351=+1 ;CLIMB OR UP-CUT ~
  Q201=-20 ;DEPTH ~
  Q202=5 ;PLUNGING DEPTH ~
  Q369=0.1 ;ALLOWANCE FOR FLOOR ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q338=5 ;INFEED FOR FINISHING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q203=+0.5 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q370=1 ;TOOL PATH OVERLAP ~
  Q366=1 ;PLUNGE ~
  Q385=500 ;FINISHING FEED RATE
5 L X+50 Y+50 R0 FMAX M99
6 CYCL DEF 254 CIRCULAR SLOT ~
  Q215=0 ;MACHINING OPERATION ~
  Q219=12 ;SLOT WIDTH ~
  Q368=0.2 ;ALLOWANCE FOR SIDE ~
  Q375=80 ;PITCH CIRCLE DIAMETR ~
  Q367=0 ;REF. SLOT POSITION ~
  Q216=+50 ;CENTER IN 1ST AXIS ~
  Q217=+50 ;CENTER IN 2ND AXIS ~
  Q376=+45 ;STARTING ANGLE ~
  Q248=90 ;ANGULAR LENGTH ~
  Q378=0 ;STEPPING ANGLE ~
  Q377=1 ;NR OF REPETITIONS ~
  Q207=500 ;FEED RATE FOR MILLNG ~
  Q351=+1 ;CLIMB OR UP-CUT ~
  Q201=-20 ;DEPTH ~
  Q202=5 ;PLUNGING DEPTH ~
  Q369=0.1 ;ALLOWANCE FOR FLOOR ~
  Q206=150 ;FEED RATE FOR PLNGNG ~
  Q338=5 ;INFEED FOR FINISHING ~
  Q200=2 ;SET-UP CLEARANCE ~
  Q203=+0 ;SURFACE COORDINATE ~
  Q204=50 ;2ND SET-UP CLEARANCE ~
  Q366=1 ;PLUNGE ~
  Q385=500 ;FINISHING FEED RATE
7 CYCL CALL
8 L Z+100.5 R0 FMAX M30
9 END PGM POCKETS MM
