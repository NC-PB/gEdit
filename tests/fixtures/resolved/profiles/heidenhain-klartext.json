{
  "addresses": {
    "angular": [
      "A",
      "B",
      "C"
    ],
    "axes": [
      "X",
      "Y",
      "Z",
      "A",
      "B",
      "C",
      "U",
      "V",
      "W"
    ],
    "feed": "F",
    "feedUnitWords": {
      "FU": "per-rev",
      "FZ": "per-tooth"
    },
    "rapid": "FMAX",
    "spindle": "S"
  },
  "codes": "heidenhain",
  "detect": {
    "content": [
      {
        "pattern": "^\\s*\\d+\\s+BEGIN\\s+PGM\\s+\\S+\\s+(?:MM|INCH)(?![A-Z0-9_])",
        "weight": 5000
      },
      {
        "pattern": "^\\s*(\\d+\\s+)?BEGIN\\s+PGM\\b",
        "weight": 5
      },
      {
        "pattern": "^\\s*(\\d+\\s+)?TOOL\\s+CALL\\b",
        "weight": 5
      },
      {
        "pattern": "^\\s*\\d+\\s+(?:(?:L|LN|LP|CC|C|CR|CT|CP|RND|CHF|APPR|DEP|LBL|CYCL|FN|PLANE|FUNCTION|TOOL|BLK|END)(?![A-Z0-9_])|[*;]|[MQ]\\d)",
        "weight": 2
      },
      {
        "pattern": "\\bFMAX\\b",
        "weight": 1
      }
    ],
    "extensions": {
      "h": 10
    }
  },
  "editing": {
    "forceUppercase": false,
    "preventLineJoin": true
  },
  "files": {
    "defaultExtension": "h",
    "encoding": "keep",
    "extensions": [
      "h"
    ],
    "filterName": "Heidenhain Klartext",
    "lineEnding": "keep",
    "newFileLineEnding": "crlf"
  },
  "grammar": "klartext",
  "id": "heidenhain-klartext",
  "machineType": "mill",
  "name": "Heidenhain Klartext",
  "numbering": {
    "mode": "consecutive",
    "start": 0,
    "step": 1
  },
  "outline": [
    {
      "kind": "section",
      "pattern": "^\\s*(?:/\\s*)?\\d+\\s+(?:/\\s*)?\\*\\s*-?\\s*(?<text>.*)$"
    },
    {
      "kind": "comment",
      "pattern": "^\\s*(?:/\\s*)?\\d+\\s*(?:/\\s*)?;\\s*(?<text>.*)$"
    },
    {
      "kind": "program",
      "pattern": "^\\s*\\d+\\s+(?<text>BEGIN\\s+PGM\\s+(?<name>\\S+)(?:\\s+(?:MM|INCH))?)"
    },
    {
      "kind": "label",
      "pattern": "^\\s*\\d+\\s+(?:/\\s*)?(?<text>LBL\\s+(?<name>(?!0(?![\\d.]))\\S+))"
    },
    {
      "kind": "subprogram-call",
      "pattern": "\\b(?<text>(?:CALL\\s+(?:LBL|PGM)|SEL\\s+PGM)\\s+\\S+(?:\\s+REP\\s+\\S+)?)"
    },
    {
      "kind": "stop",
      "pattern": "\\b(STOP|M0?[01])\\b"
    },
    {
      "kind": "end",
      "pattern": "\\bEND\\s+PGM\\b|\\bM(?:30|2)\\b"
    }
  ],
  "program": {
    "end": [
      "\\bEND\\s+PGM\\b"
    ],
    "endRecord": true,
    "start": [
      "\\bBEGIN\\s+PGM\\s+(?<name>\\S+)"
    ]
  },
  "shortName": "Heidenhain",
  "syntax": {
    "blockNumber": {
      "mandatory": true,
      "mode": "leading-integer"
    },
    "blockSkip": {
      "chars": "/",
      "position": "either"
    },
    "comments": [
      {
        "end": null,
        "start": ";"
      }
    ],
    "continuation": "~\\s*$",
    "continuationMark": "~",
    "decimalPointSignificant": false,
    "decimalSeparator": ".",
    "decimalSeparatorAlt": ",",
    "incrementalPrefix": "I",
    "keywords": [
      "BEGIN PGM",
      "END PGM",
      "BLK FORM",
      "TOOL CALL",
      "TOOL DEF",
      "CYCL DEF",
      "CYCL CALL PAT",
      "CYCL CALL POS",
      "CYCL CALL",
      "CALL LBL",
      "CALL PGM",
      "SEL PGM",
      "LBL",
      "REP",
      "APPR LT",
      "APPR LN",
      "APPR CT",
      "APPR LCT",
      "DEP LT",
      "DEP LN",
      "DEP CT",
      "DEP LCT",
      "RND",
      "CHF",
      "CTP",
      "CT",
      "CP",
      "CC",
      "CR",
      "LP",
      "LN",
      "L",
      "C",
      "FMAX",
      "FAUTO",
      "FN",
      "STOP",
      "PLANE SPATIAL",
      "PLANE RESET",
      "PLANE PROJECTED",
      "PLANE EULER",
      "PLANE VECTOR",
      "PLANE POINTS",
      "PLANE RELATIV",
      "PLANE AXIAL",
      "MOVE",
      "TURN",
      "STAY",
      "TABLE ROT",
      "COORD ROT",
      "SEQ+",
      "SEQ-",
      "MB",
      "MAX",
      "FUNCTION TCPM",
      "FUNCTION RESET TCPM",
      "F TCP",
      "F CONT",
      "AXIS POS",
      "AXIS SPAT",
      "PATHCTRL AXIS",
      "PATHCTRL VECTOR",
      "REFPNT TIP-TIP",
      "REFPNT TIP-CENTER",
      "REFPNT CENTER-CENTER",
      "TRANS DATUM",
      "MM",
      "INCH"
    ],
    "sectionHeading": "^\\s*(?:/\\s*)?\\d+\\s+(?:/\\s*)?\\*",
    "strings": true,
    "variables": "Q[LRS]?\\d+",
    "wordSeparatorRequired": true
  },
  "toolCall": {
    "tool": "TOOL\\s+CALL\\s+(?<tool>\\d+(\\.\\d)?|\"[^\"]+\"|QS\\d+)\\s*(?<axis>[XYZ])?\\b",
    "toolFrom": "same-line",
    "trigger": "\\bTOOL\\s+CALL\\s+(\\d|\"|QS\\d)"
  },
  "version": 1
}
