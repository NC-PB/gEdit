      "tool": "(?<![A-Z])T(?<tool>\\d{2}(?=\\d{3}(?!\\d))|\\d{1,2}?(?=\\d{2}(?!\\d))|\\d{1,2}(?!\\d))\\d{0,3}(?!\\d)",
      "toolFrom": "same-line",
