          "weight": 4
        },
        {
          "pattern": "(?<![A-Z])G0*7[0-3](?![\\d.])(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)",
          "weight": 6
        },
        {
          "pattern": "(?<![A-Z])G0*7[12]\\s*U[\\d.]+\\s*R",
          "weight": 6
        },
        {
          "pattern": "^(?![^(]*(?<![A-Z])G0*91(?![\\d.]))[^(]*?(?<![A-Z])G0*(?:28|30)(?![\\d.])[ \\t]*(?:(?:P\\d[ \\t]*)?(?:W[-+]?[.\\d]+[ \\t]*)?[UVH]|W)[-+]?[.\\d]",
          "weight": 4
        },
        {
          "pattern": "(?<![A-Z])[UW][-+]?\\.?\\d",
