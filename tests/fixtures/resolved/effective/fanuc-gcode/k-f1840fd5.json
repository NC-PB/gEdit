{
  "codes": "fanuc",
  "machine": {
    "choice": "document",
    "id": "review",
    "name": "review",
    "params": {
      "diameter": null,
      "modalInitial": {},
      "numberInput": {
        "incrementDeg": "0.001",
        "incrementInch": "0.0001",
        "incrementMm": "0.001",
        "incrementSec": "0.001",
        "mode": "increment"
      },
      "units": "mm",
      "variants": {}
    },
    "source": {
      "diameter": "profile",
      "modalInitial": {
        "feedmode": "profile"
      },
      "numberInput": "machine",
      "units": "profile",
      "variants": {}
    }
  },
  "profile": {
    "addresses": {
      "angular": [
        "A",
        "B",
        "C"
      ],
      "arcCenter": [
        "I",
        "J",
        "K"
      ],
      "arcCenterMode": "incremental",
      "axes": [
        "X",
        "Y",
        "Z",
        "A",
        "B",
        "C",
        "U",
        "V",
        "W"
      ],
      "feed": "F",
      "spindle": "S",
      "tool": "T"
    },
    "codes": "fanuc",
    "compare": {
      "ignoreBlockNumbers": true,
      "ignoreCase": false,
      "ignoreComments": true,
      "ignoreNumberFormat": true,
      "ignoreWhitespace": true,
      "keepComments": [
        "^\\s*(?:[O:]\\d+|<[^>]*>)",
        "#\\s*30(?:00|06)\\s*=",
        "\\([^)]*%"
      ]
    },
    "detect": {
      "content": [
        {
          "pattern": "^\\s*%\\s*$",
          "weight": 5
        },
        {
          "pattern": "^\\s*[O:]\\d{1,8}(?!\\d)",
          "weight": 5
        },
        {
          "pattern": "^\\s*N\\d+",
          "weight": 1
        },
        {
          "pattern": "^\\s*(N\\d+\\s*)?[GM]\\d{1,3}(\\.\\d)?(?![\\d.])",
          "weight": 1
        },
        {
          "pattern": "^\\s*\\([^)]*\\)\\s*$",
          "weight": 1
        },
        {
          "pattern": "(?<![A-Z])M0*6(?!\\d)",
          "weight": 3
        },
        {
          "pattern": "(?<![A-Z])G0*4[34](?![\\d.])(?=[^(]*H\\d)",
          "weight": 3
        },
        {
          "pattern": "(?<![A-Z])G0*17(?![\\d.])",
          "weight": 1
        },
        {
          "pattern": "(?<![A-Z])Y[-+]?\\.?\\d",
          "weight": 1
        }
      ],
      "extensions": {
        "cnc": 2,
        "eia": 2,
        "iso": 2,
        "nc": 3,
        "tap": 3
      },
      "priority": 1
    },
    "editing": {
      "forceUppercase": true,
      "preventLineJoin": true,
      "tabWidth": 4
    },
    "files": {
      "defaultExtension": "nc",
      "encoding": "keep",
      "extensions": [
        "nc",
        "tap",
        "cnc",
        "eia",
        "iso",
        "ncc",
        "ptp",
        "txt"
      ],
      "filterName": "Fanuc G-Code",
      "lineEnding": "keep",
      "newFileLineEnding": "crlf"
    },
    "grammar": "iso",
    "id": "fanuc-gcode",
    "machineParams": {
      "modalGroups": [
        "feedmode",
        "distance",
        "plane"
      ],
      "numberInput": {
        "default": "is-b",
        "presets": [
          {
            "id": "is-b",
            "label": "Increments of 0.001 mm (IS-B): X50 is 0.050 mm, X50. is 50 mm, C90000 is 90°; a point-less feed per minute in 1 mm/min (F200 is 200), per revolution in 0.01 mm/rev (F25 is 0.25 mm/rev)",
            "source": "syntax-fanuc.md §3.2",
            "value": {
              "classes": {
                "feedPerMin": {
                  "increment": "1",
                  "incrementInch": "0.01",
                  "mode": "increment"
                },
                "feedPerRev": {
                  "increment": "0.01",
                  "incrementInch": "0.0001",
                  "mode": "increment"
                }
              },
              "incrementDeg": "0.001",
              "incrementInch": "0.0001",
              "incrementMm": "0.001",
              "incrementSec": "0.001",
              "mode": "increment"
            },
            "verify": true
          },
          {
            "id": "is-c",
            "label": "Increments of 0.0001 mm (IS-C): X50 is 0.0050 mm, X50. is 50 mm; a point-less feed per minute in 1 mm/min (F200 is 200), per revolution in 0.01 mm/rev (F25 is 0.25 mm/rev)",
            "source": "syntax-fanuc.md §3.2",
            "value": {
              "classes": {
                "feedPerMin": {
                  "increment": "1",
                  "incrementInch": "0.01",
                  "mode": "increment"
                },
                "feedPerRev": {
                  "increment": "0.01",
                  "incrementInch": "0.0001",
                  "mode": "increment"
                }
              },
              "incrementDeg": "0.0001",
              "incrementInch": "0.00001",
              "incrementMm": "0.0001",
              "incrementSec": "0.0001",
              "mode": "increment"
            },
            "verify": true
          },
          {
            "id": "calculator",
            "label": "As written: X50 and X50. are both 50 mm; the mill has no cycle parameter with a fixed micron reading, so Q and the rest read the same way",
            "source": "syntax-fanuc.md §3.2",
            "value": {
              "incrementMm": "0.001",
              "mode": "calculator"
            },
            "verify": true
          }
        ]
      },
      "units": "mm"
    },
    "machineType": "mill",
    "modal": {
      "initial": {
        "feedmode": "G94"
      },
      "sources": {
        "feedmode": "profile",
        "units": "profile"
      },
      "units": "mm"
    },
    "name": "Fanuc (ISO) mill",
    "numbering": {
      "digits": 0,
      "max": 99999,
      "onOverflow": "wrap",
      "references": [
        {
          "addresses": [
            "P"
          ],
          "rewrite": false,
          "trigger": "(?<![A-Z])M\\s*0*99(?!\\d)"
        },
        {
          "addresses": [
            "Q"
          ],
          "trigger": "^(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)"
        },
        {
          "addresses": [
            "Q"
          ],
          "rewrite": false,
          "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)"
        },
        {
          "addresses": [
            "P",
            "Q"
          ],
          "rewrite": false,
          "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])G\\s*0*7[0-3](?:\\.7)?(?![\\d.])"
        },
        {
          "addresses": [
            "GOTO"
          ],
          "trigger": "(?<![A-Z])GOTO"
        }
      ],
      "restartAtProgramStart": true,
      "skipEmpty": true,
      "skipStartingWith": [
        "%",
        "O",
        "("
      ],
      "spacesAfter": 1,
      "start": 10,
      "step": 10
    },
    "onLoad": {
      "stripNul": true
    },
    "outline": [
      {
        "kind": "program",
        "pattern": "^\\s*[O:](?<name>\\d+)"
      },
      {
        "kind": "program",
        "pattern": "^\\s*<(?<name>[A-Za-z0-9+\\-_.]+)>"
      },
      {
        "kind": "comment",
        "pattern": "^\\s*\\((?<text>[^)]*)\\)\\s*$"
      },
      {
        "kind": "stop",
        "pattern": "(?<![A-Z])M0*[01](?!\\d)"
      },
      {
        "kind": "subprogram-call",
        "pattern": "(?<![A-Z])(?<text>M0*98\\s*(?:[PQ]\\d+|<[A-Za-z0-9+\\-_.]+>)(?:\\s*L\\d+)?|G0*65\\s*(?:P\\d+|<[A-Za-z0-9+\\-_.]+>))"
      },
      {
        "kind": "end",
        "pattern": "(?<![A-Z])M0*(?:30|2|99)(?!\\d)"
      }
    ],
    "program": {
      "end": [
        "(?<![A-Z])M0*(30|2)(?!\\d)"
      ],
      "start": [
        "^\\s*O(?<name>\\d+)",
        "^\\s*:(?<name>\\d+)",
        "^\\s*<(?<name>[A-Za-z0-9+\\-_.]+)>"
      ]
    },
    "shortName": "Fanuc",
    "syntax": {
      "blockNumber": {
        "altPrefixes": [],
        "mandatory": false,
        "mode": "prefix",
        "prefix": "N"
      },
      "blockSkip": {
        "chars": "/",
        "levels": true,
        "plainLevel": "1",
        "position": "either"
      },
      "comments": [
        {
          "end": ")",
          "start": "("
        }
      ],
      "decimalPointSignificant": true,
      "decimalSeparator": ".",
      "keywords": [
        "GOTO",
        "IF",
        "THEN",
        "WHILE",
        "DO",
        "END",
        "EQ",
        "NE",
        "GT",
        "LT",
        "GE",
        "LE",
        "AND",
        "OR",
        "XOR",
        "MOD",
        "SIN",
        "COS",
        "TAN",
        "ASIN",
        "ACOS",
        "ATAN",
        "ATN",
        "SQRT",
        "SQR",
        "ABS",
        "BIN",
        "BCD",
        "ROUND",
        "RND",
        "FIX",
        "FUP",
        "LN",
        "EXP",
        "POW",
        "ADP",
        "AX",
        "AXNUM",
        "POPEN",
        "PCLOS",
        "DPRNT",
        "BPRNT"
      ],
      "maxWordDigits": 8,
      "programNames": "<[A-Za-z0-9+\\-_.]+>",
      "variables": "#\\d+",
      "wordSeparatorRequired": false
    },
    "toolCall": {
      "ignore": "^(?:(?!(?<![A-Z])T\\d).)*(?<![A-Z])T0+(?!\\d)",
      "tool": "(?<![A-Z])T(?<tool>\\d+)",
      "toolFrom": "same-line-or-last",
      "trigger": "(?<![A-Z])M0*6(?!\\d)"
    },
    "toolList": {
      "commentFilter": "^[-*=_\\s]*$",
      "description": "auto",
      "dropLeadingZeros": true
    },
    "version": 1
  }
}
