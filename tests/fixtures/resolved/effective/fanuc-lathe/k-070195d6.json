    "machineType": "lathe",
    "modal": {
      "diameter": "on",
      "initial": {
        "feedmode": "G99",
        "plane": "G18",
        "spindlemode": "G97"
      },
      "sources": {
        "diameter": "profile",
        "feedmode": "profile",
        "plane": "profile",
        "spindlemode": "profile",
        "units": "profile"
      },
      "units": "mm"
    },
    "name": "Fanuc (ISO) lathe",
    "numbering": {
      "digits": 0,
      "max": 99999,
      "onOverflow": "wrap",
      "references": [
        {
          "addresses": [
            "P"
          ],
          "rewrite": false,
          "trigger": "(?<![A-Z])M\\s*0*99(?!\\d)"
        },
        {
          "addresses": [
            "Q"
          ],
          "trigger": "^(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)"
        },
        {
          "addresses": [
            "Q"
          ],
          "rewrite": false,
          "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])M\\s*0*98(?!\\d)"
        },
        {
          "addresses": [
            "P",
            "Q"
          ],
          "trigger": "^(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)[^(]*(?<![A-Z])G\\s*0*7[0-3](?![\\d.])"
        },
        {
          "addresses": [
            "GOTO"
          ],
          "trigger": "(?<![A-Z])GOTO"
        }
      ],
      "restartAtProgramStart": true,
      "skipEmpty": true,
      "skipStartingWith": [
        "%",
        "O",
        "("
      ],
      "spacesAfter": 1,
      "start": 10,
      "step": 10
    },
    "onLoad": {
      "stripNul": true
    },
    "outline": [
      {
        "kind": "program",
        "pattern": "^\\s*[O:](?<name>\\d+)"
      },
      {
        "kind": "program",
        "pattern": "^\\s*<(?<name>[A-Za-z0-9+\\-_.]+)>"
      },
      {
        "kind": "comment",
        "pattern": "^\\s*\\((?<text>[^)]*)\\)\\s*$"
      },
      {
        "kind": "stop",
        "pattern": "(?<![A-Z])M0*[01](?!\\d)"
      },
      {
        "kind": "subprogram-call",
        "pattern": "(?<![A-Z])(?<text>M0*98\\s*(?:[PQ]\\d+|<[A-Za-z0-9+\\-_.]+>)(?:\\s*L\\d+)?|G0*65\\s*(?:P\\d+|<[A-Za-z0-9+\\-_.]+>))"
      },
      {
        "kind": "end",
        "pattern": "(?<![A-Z])M0*(?:30|2|99)(?!\\d)"
      }
    ],
    "program": {
      "end": [
        "(?<![A-Z])M0*(30|2)(?!\\d)"
      ],
      "start": [
        "^\\s*O(?<name>\\d+)",
        "^\\s*:(?<name>\\d+)",
        "^\\s*<(?<name>[A-Za-z0-9+\\-_.]+)>"
      ]
    },
    "shortName": "Fanuc T",
    "syntax": {
      "blockNumber": {
        "altPrefixes": [],
        "mandatory": false,
        "mode": "prefix",
        "prefix": "N"
      },
      "blockSkip": {
        "chars": "/",
        "levels": true,
        "plainLevel": "1",
        "position": "either"
      },
      "comments": [
        {
          "end": ")",
          "start": "("
        }
      ],
      "decimalPointSignificant": false,
      "decimalSeparator": ".",
      "keywords": [
        "GOTO",
        "IF",
        "THEN",
        "WHILE",
        "DO",
        "END",
        "EQ",
        "NE",
        "GT",
        "LT",
        "GE",
        "LE",
        "AND",
        "OR",
        "XOR",
        "MOD",
        "SIN",
        "COS",
        "TAN",
        "ASIN",
        "ACOS",
        "ATAN",
        "ATN",
        "SQRT",
        "SQR",
        "ABS",
        "BIN",
        "BCD",
        "ROUND",
        "RND",
        "FIX",
        "FUP",
        "LN",
        "EXP",
        "POW",
        "ADP",
        "AX",
        "AXNUM",
        "POPEN",
        "PCLOS",
        "DPRNT",
        "BPRNT"
      ],
      "maxWordDigits": 8,
      "programNames": "<[A-Za-z0-9+\\-_.]+>",
      "variables": "#\\d+",
      "wordSeparatorRequired": false
    },
    "toolCall": {
      "ignore": "(?<![A-Z])T(?:\\d{0,3}00|0+)(?!\\d)",
      "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)(?:\\d{2})?(?!\\d)",
      "toolFrom": "same-line",
      "trigger": "(?<![A-Z])T\\d{1,5}(?!\\d)"
    },
    "toolList": {
      "commentFilter": "^[-*=_\\s]*$",
      "description": "auto",
      "dropLeadingZeros": true
    },
    "version": 1
  }
