    "compare": {
      "ignoreBlockNumbers": true,
      "ignoreCase": false,
      "ignoreComments": true,
      "ignoreNumberFormat": true,
      "ignoreWhitespace": true,
      "keepComments": [
        "^\\s*(?:[O:]\\d+|<[^>]*>)",
        "#\\s*30(?:00|06)\\s*=",
        "\\([^)]*%"
      ]
    },
    "detect": {
      "content": [
        {
          "pattern": "^\\s*%\\s*$",
          "weight": 5
        },
        {
          "pattern": "^\\s*[O:]\\d{1,8}(?!\\d)",
          "weight": 5
        },
        {
          "pattern": "^\\s*N\\d+",
          "weight": 1
        },
        {
          "pattern": "^\\s*(N\\d+\\s*)?[GM]\\d{1,3}(\\.\\d)?(?![\\d.])",
          "weight": 1
        },
        {
          "pattern": "^\\s*\\([^)]*\\)\\s*$",
          "weight": 1
        },
        {
          "pattern": "(?<![A-Z])T\\d{4,5}(?!\\d)",
          "weight": 3
        },
        {
          "pattern": "(?<![A-Z])G0*50\\s*S\\d",
          "weight": 4
        },
        {
          "pattern": "(?<![A-Z])G0*92\\s*S\\d",
          "weight": 4
        },
        {
          "pattern": "(?<![A-Z])G0*9[67](?![\\d.])",
          "weight": 4
        },
        {
          "pattern": "(?<![A-Z])G0*7[0-3](?![\\d.])(?=[^(]*P\\s*\\d)(?=[^(]*Q\\s*\\d)",
          "weight": 6
        },
        {
          "pattern": "(?<![A-Z])G0*7[12]\\s*U[\\d.]+\\s*R",
          "weight": 6
        },
        {
          "pattern": "^(?![^(]*(?<![A-Z])G0*91(?![\\d.]))[^(]*?(?<![A-Z])G0*(?:28|30)(?![\\d.])[ \\t]*(?:(?:P\\d[ \\t]*)?(?:W[-+]?[.\\d]+[ \\t]*)?[UVH]|W)[-+]?[.\\d]",
          "weight": 4
        },
        {
          "pattern": "(?<![A-Z])[UW][-+]?\\.?\\d",
          "weight": 1
        }
      ],
      "extensions": {
        "cnc": 2,
        "eia": 2,
        "iso": 2,
        "nc": 3,
        "tap": 3
      },
      "priority": 0
