              "incrementInch": "0.00001",
              "incrementMm": "0.0001",
              "incrementSec": "0.0001",
              "mode": "increment"
            },
            "verify": true
          },
          {
            "id": "calculator",
            "label": "As written: X50 and X50. are both 50 mm; G74/G75 P and Q, G76 Q and G83/G87 Q are in microns (Q6000 is 6 mm)",
            "source": "syntax-fanuc.md §3.2",
            "value": {
              "incrementMm": "0.001",
              "mode": "calculator"
            },
            "verify": true
          }
        ]
      },
      "units": "mm",
      "variants": [
        {
          "choices": [
            {
              "codes": "fanuc-lathe",
              "detect": [
                {
                  "pattern": "(?<![A-Z])G0*50\\s*S\\d",
                  "weight": 4
                },
                {
                  "pattern": "(?<![A-Z])G0*9[89](?![\\d.])",
                  "weight": 2
