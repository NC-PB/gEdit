        {
          "choices": [
            {
              "label": "The last two digits are the offset: T0101 (default, verify)",
              "overlay": {
                "toolCall": {
                  "ignore": "(?<![A-Z])T(?:\\d{0,3}00|0+)(?!\\d)",
                  "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)(?:\\d{2})?(?!\\d)",
                  "trigger": "(?<![A-Z])T\\d{1,5}(?!\\d)"
                }
              },
              "value": "offset2"
            },
            {
              "label": "The last digit is the offset: T11",
              "overlay": {
                "toolCall": {
                  "ignore": "(?<![A-Z])T(?:\\d{0,3}0|0+)(?!\\d)",
                  "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)\\d?(?!\\d)",
                  "trigger": "(?<![A-Z])T\\d{1,4}(?!\\d)"
                }
              },
              "value": "offset1"
            },
            {
              "label": "The last three digits are the offset: T1001",
              "overlay": {
                "toolCall": {
                  "ignore": "(?<![A-Z])T(?:\\d{0,3}000|0+)(?!\\d)",
                  "tool": "(?<![A-Z])T(?<tool>\\d{1,3}?)(?:\\d{3})?(?!\\d)",
                  "trigger": "(?<![A-Z])T\\d{1,6}(?!\\d)"
                }
              },
              "value": "offset3"
            }
          ],
          "default": "offset2",
          "id": "toolWord",
          "label": "Tool word: offset digits"
