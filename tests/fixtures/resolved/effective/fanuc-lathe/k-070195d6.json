                  "increment": "1",
                  "incrementInch": "0.01",
                  "mode": "increment"
                },
                "feedPerRev": {
                  "increment": "0.01",
                  "incrementInch": "0.0001",
                  "mode": "increment"
                }
              },
              "incrementDeg": "0.001",
              "incrementInch": "0.0001",
              "incrementMm": "0.001",
              "incrementSec": "0.001",
              "mode": "increment"
            },
            "verify": true
          },
          {
            "id": "is-c",
            "label": "Increments of 0.0001 mm (IS-C): X50 is 0.0050 mm, X50. is 50 mm; a point-less feed per minute in 1 mm/min (F200 is 200), per revolution in 0.01 mm/rev (F25 is 0.25 mm/rev)",
            "source": "syntax-fanuc.md §3.2",
            "value": {
              "classes": {
                "feedPerMin": {
                  "increment": "1",
                  "incrementInch": "0.01",
                  "mode": "increment"
                },
                "feedPerRev": {
