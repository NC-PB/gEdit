      },
      {
        "kind": "subprogram-call",
        "pattern": "(?<![A-Z_])(?<text>EXTCALL(?:[ \\t]*\\([ \\t]*(?:\"[^\"]*\"|[A-Z_][A-Z0-9_]*)[ \\t]*\\)|[ \\t]+\"[^\"]*\")|(?:PCALL|ISOCALL|CALL)(?:[ \\t]+(?:\"[^\"]*\"|[A-Z0-9_/]+)|[ \\t]*/[A-Z0-9_/]+)|L\\d+(?![\\d.]))"
      },
      {
        "kind": "subprogram-call",
        "pattern": "^\\s*(?:/\\d?[ \\t]*)?(?:N\\d+[ \\t]+)?(?=[A-Z_]*[0-9_]|[A-Z_][A-Z0-9_]*[ \\t]+P\\d)(?!(?:CUT3DCCD|CUT3DCC|CUT3DC|ORIVIRT[12]|DIAM90|B_AND|B_NOT|B_XOR|CUT2D|B_OR|CUT2DF|CUT3DFS|CUT3DFF|CUT3DF|CDOF2|ORIRPY2|WALCS\\d+)(?![A-Z0-9_]))(?<text>(?:[A-Z]{2}|_[A-Z])[A-Z0-9_]*(?:[ \\t]+P\\d+)?)[ \\t]*$"
      },
      {
        "kind": "stop",
        "pattern": "(?<![A-Z_])M0*[01](?![\\d.]|\\s*=)"
      },
      {
        "kind": "end",
        "pattern": "(?<![A-Z_])(?:M0*(?:2|30|17)(?![\\d.]|\\s*=)|RET(?![A-Z0-9_]))"
