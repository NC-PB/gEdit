%_N_S11_TWO_CHANNEL_1_MPF
; WRITTEN FOR GEDIT - SYNTHETIC TEST PROGRAM, NOT FOR A MACHINE
;$PATH=/_N_MPF_DIR
; CHANNEL 1 OF TWO; THE CHANNELS ARE NAMED TURN_MAIN AND TURN_SUB IN THE WAITS
N10 G18 G90 G95 G40 G500 DIAMON
N20 G54
N30 WAITM(10,TURN_MAIN,TURN_SUB)
N40 MSG("OD ROUGH")
N50 T="ROUGH" D1
N60 G96 S200 LIMS=3000 M4
N70 G0 X64 Z2 M8
N80 G1 Z-40 F0.25
N90 G0 X200 Z200 M9
